# Copy to .env (auto-loaded by pydantic-settings) and fill in values.
# The repo has historically used `secrets.env` + `source secrets.env`; either works.
# Never commit either file.

# --- Database (dev DB on Railway — never point local dev at production) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Season / league defaults ---
# Both derive from today's date when unset (NBA_SEASON flips on Aug 1, ESPN_YEAR is
# the season's end year); set them only to pin a season, e.g. for backfills.
ESPN_YEAR=2027
NBA_SEASON=2026-27
ESPN_LEAGUE_ID=

# --- Auth for cron-runner / backend calls into /v1/internal/* ---
PIPELINE_API_TOKEN=

# --- External data sources ---
# Residential proxy for nba_api (stats.nba.com blocks datacenter IPs)
NBA_API_PROXY_URL=
# BALLDONTLIE_API_KEY=

# --- Nightly deploy job (fires repository_dispatch on both repos) ---
# GITHUB_DEPLOY_TOKEN=
# BACKEND_GITHUB_REPO=jlkendrick/courtvision-backend
# DATA_PLATFORM_GITHUB_REPO=jameslk3/courtvision-data

# --- Lineup alert emails ---
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=alerts@courtvision.dev

# --- Ops alerts (one Discord/Slack incoming webhook for #cv-alerts) ---
# Leave unset locally and on staging: without a URL every alert is a logged no-op.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_WEBHOOK_FORMAT=discord            # or slack
# ALERTS_ENABLED=true
# Consecutive cron-runner failures before cron_failure_streak fires (JSON; unknown jobs use the default)
# ALERT_CRON_STREAK_THRESHOLDS={"live-stats":3,"pre-game":2,"post-game":2,"playoffs":2,"schedule-sync":1,"deploy":1}
# ALERT_CRON_STREAK_DEFAULT_THRESHOLD=2

# --- Observability ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# APP_VERSION is set on the Railway service by the deploy workflow; leave unset locally ("dev")

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
DEVELOPMENT_MODE=true
